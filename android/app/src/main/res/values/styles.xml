<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/app_window_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>
    <style name="PageAnimation" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/page_open_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/page_open_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/page_close_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/page_close_exit</item>
    </style>
    <!-- Launch theme + slide/fade transition for the dedicated Flutter page activities. -->
    <style name="PageLaunchTheme" parent="LaunchTheme">
        <item name="android:windowAnimationStyle">@style/PageAnimation</item>
    </style>
</resources>
